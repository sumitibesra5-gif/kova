# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret used to sign HttpOnly session cookies.
SESSION_SECRET="replace-with-strong-random-secret"

# ADMIN_USERNAME & ADMIN_PASSWORD: Initial administrator credentials configured securely on backend.
ADMIN_USERNAME="mili"
ADMIN_PASSWORD="SET_SECURE_ADMIN_PASSWORD"
